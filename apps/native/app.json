{
  "expo": {
    "name": "Tic-Tac-Chor",
    "description": "A playful tic-tac-toe duel with a satirical opponent and a new illustrated backdrop every round.",
    "slug": "tic-tac-chor",
    "version": "1.0.0",
    "orientation": "default",
    "backgroundColor": "#fff8ed",
    "icon": "./assets/images/icon.png",
    "scheme": "tic-tac-chor",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.tic-tac-chor"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#fff8ed",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.tictacchor"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 144,
          "resizeMode": "contain",
          "backgroundColor": "#fff8ed",
          "dark": {
            "backgroundColor": "#211f20"
          }
        }
      ],
      [
        "expo-audio",
        {
          "recordAudioAndroid": false,
          "microphonePermission": false,
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
