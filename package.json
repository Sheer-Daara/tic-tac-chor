{
  "name": "tic-tac-chor",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp run -r dev",
    "build": "vp run -r build",
    "check-types": "vp run -r check-types",
    "check": "vp check && vp run -r check-types",
    "lint": "vp lint",
    "format": "vp fmt",
    "staged": "vp staged",
    "hooks:setup": "vp config",
    "dev:native": "vp run --filter native dev",
    "dev:web": "vp run --filter web dev:bare",
    "deploy": "vp run --filter @tic-tac-chor/infra deploy",
    "deploy:prod": "vp run --filter @tic-tac-chor/infra deploy:prod",
    "auth": "vp run --filter @tic-tac-chor/infra auth",
    "destroy": "vp run --filter @tic-tac-chor/infra destroy",
    "destroy:prod": "vp run --filter @tic-tac-chor/infra destroy:prod",
    "env:generate": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/native/",
    "postinstall": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/native/",
    "alchemy": "alchemy"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260906.1",
    "@tic-tac-chor/config": "workspace:*",
    "@types/node": "catalog:",
    "rolldown": "1.2.7",
    "typescript": "^6.0.3",
    "varlock": "catalog:",
    "vite-plus": "0.3.1"
  },
  "packageManager": "pnpm@12.8.1"
}
